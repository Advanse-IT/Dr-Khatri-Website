# Cloudflare Pages — Security & Caching Headers
# Dr Shailesh Khatri — drskhatri.com.au

/*
  # Security headers
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cross-Origin-Embedder-Policy: unsafe-none

  # HSTS (enable once HTTPS confirmed stable — 6 months)
  Strict-Transport-Security: max-age=15552000; includeSubDomains; preload

  # Content Security Policy — allows Google Maps iframes & Google Fonts
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://fonts.googleapis.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://fonts.gstatic.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https: blob:; frame-src https://www.google.com https://maps.google.com; connect-src 'self' https://fonts.googleapis.com https://www.google.com; worker-src blob:;

# HTML pages — no cache (always fresh)
/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

# Hashed JS/CSS assets — cache forever (Vite adds content hashes)
/assets/*.js
  Cache-Control: public, max-age=31536000, immutable

/assets/*.css
  Cache-Control: public, max-age=31536000, immutable

# Images — cache for 1 year
/images/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts
*.woff2
  Cache-Control: public, max-age=31536000, immutable

*.woff
  Cache-Control: public, max-age=31536000, immutable

# Favicons — 1 week
/favicon*
  Cache-Control: public, max-age=604800

/apple-touch-icon*
  Cache-Control: public, max-age=604800

/android-chrome*
  Cache-Control: public, max-age=604800

# Sitemap & robots — 1 day
/sitemap.xml
  Cache-Control: public, max-age=86400

/sitemap-images.xml
  Cache-Control: public, max-age=86400

/robots.txt
  Cache-Control: public, max-age=86400

# Manifest
/site.webmanifest
  Cache-Control: public, max-age=86400
  Content-Type: application/manifest+json

# Redirects
